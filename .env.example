# Copy to .env and fill in values. Never commit .env.

# xAI (Grok) — preferred for Copland
XAI_API_KEY=
LLM_PROVIDER=xai
LLM_MODEL=grok-4.5

# Optional overrides
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_API_HOST=https://api.x.ai/v1
# COPLAND_AGENT_HOST=127.0.0.1
# COPLAND_AGENT_PORT=5178
# COPLAND_AGENT_URL=http://127.0.0.1:5178
# COPLAND_SEED_DIR=./public/seed

# Railway / Docker (scripts/start-prod.sh sets sensible defaults):
# PORT=8080
# XAI_API_KEY=...          # required for NL chat in prod
# LLM_PROVIDER=xai
# LLM_MODEL=grok-4.5
# MuseScore CLI is NOT in the image — edits apply; SVG stays on seed until a CLI worker exists.
